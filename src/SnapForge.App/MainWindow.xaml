<Window x:Class="SnapForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:SnapForge.App.Editor"
        Title="SnapForge"
        Width="1180" Height="780" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="Assets/SnapForge.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top command bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0">
                    <Border Width="28" Height="28" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF9A4D" Offset="0" />
                                <GradientStop Color="#F0561D" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M7,11 V7 H11 M17,7 H21 V11 M21,17 V21 H17 M11,21 H7 V17" Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Border>
                    <TextBlock Text="SnapForge" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource Separator}" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="RegionButton" Style="{StaticResource ToolbarButton}" Click="OnCaptureRegion" ToolTip="Capture an area (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRegion}" />
                            <TextBlock Text="Region" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WindowButton" Style="{StaticResource ToolbarButton}" Click="OnCaptureWindow" ToolTip="Capture a window (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWindow}" />
                            <TextBlock Text="Window" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DisplayButton" Style="{StaticResource ToolbarButton}" Click="OnCaptureDisplay" ToolTip="Capture one display (Ctrl+3)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconScreen}" />
                            <TextBlock Text="Display" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AllDisplaysButton" Style="{StaticResource ToolbarButton}" Click="OnCaptureAll" ToolTip="Capture all displays (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAllScreens}" />
                            <TextBlock Text="Full screen" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource Separator}" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" IsEnabled="False">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUndo}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" IsEnabled="False">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRedo}" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}" Click="OnCopy" ToolTip="Copy image to clipboard (Ctrl+C)" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" />
                            <TextBlock Text="Copy" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="OnSave" ToolTip="Save as PNG or JPEG (Ctrl+S)" IsEnabled="False" Margin="6,0,0,0" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" Stroke="#1A1205" />
                            <TextBlock Text="Save" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tool options -->
        <Border Grid.Row="1" x:Name="OptionsBar" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6" IsEnabled="False">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Color" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel DockPanel.Dock="Left" x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#E53935" Tag="#E53935" ToolTip="Red" IsChecked="True" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#FB8C00" Tag="#FB8C00" ToolTip="Orange" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#FDD835" Tag="#FDD835" ToolTip="Yellow" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#43A047" Tag="#43A047" ToolTip="Green" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#1E88E5" Tag="#1E88E5" ToolTip="Blue" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#8E24AA" Tag="#8E24AA" ToolTip="Purple" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#141414" Tag="#141414" ToolTip="Black" Checked="OnColorChecked" />
                    <RadioButton GroupName="Color" Style="{StaticResource SwatchButton}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="White" Checked="OnColorChecked" />
                </StackPanel>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource Separator}" Margin="14,0" />

                <TextBlock DockPanel.Dock="Left" Text="Size" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border DockPanel.Dock="Left" Background="{StaticResource BackgroundBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Size" Style="{StaticResource SegmentButton}" Content="S" Tag="2" ToolTip="Thin" Checked="OnSizeChecked" />
                        <RadioButton GroupName="Size" Style="{StaticResource SegmentButton}" Content="M" Tag="4" ToolTip="Medium" IsChecked="True" Checked="OnSizeChecked" />
                        <RadioButton GroupName="Size" Style="{StaticResource SegmentButton}" Content="L" Tag="6" ToolTip="Thick" Checked="OnSizeChecked" />
                        <RadioButton GroupName="Size" Style="{StaticResource SegmentButton}" Content="XL" Tag="10" ToolTip="Extra thick" Checked="OnSizeChecked" />
                    </StackPanel>
                </Border>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource Separator}" Margin="14,0" />

                <Button DockPanel.Dock="Left" x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" Click="OnDeleteSelection" ToolTip="Delete selected annotation (Del)" IsEnabled="False" MinHeight="30" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDelete}" />
                        <TextBlock Text="Delete" Margin="4,0,2,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnZoomOut" ToolTip="Zoom out (Ctrl+−)" MinHeight="30" Padding="6,3">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconZoomOut}" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <Button Style="{StaticResource ToolbarButton}" Click="OnZoomIn" ToolTip="Zoom in (Ctrl+=)" MinHeight="30" Padding="6,3">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconZoomIn}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnZoomFit" ToolTip="Fit to window (Ctrl+0)" MinHeight="30" Padding="6,3">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFit}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnZoomActual" ToolTip="Actual pixels (Ctrl+Alt+0)" MinHeight="30" Padding="8,3">
                        <TextBlock Text="1:1" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tool palette -->
            <Border Grid.Column="0" x:Name="ToolPalette" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,10" IsEnabled="False">
                <StackPanel>
                    <RadioButton x:Name="SelectTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Select" Checked="OnToolChecked" ToolTip="Select and move (V)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSelect}" />
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Arrow" Checked="OnToolChecked" ToolTip="Arrow (A) — hold Shift for 45° angles" IsChecked="True">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArrow}" />
                    </RadioButton>
                    <RadioButton x:Name="LineTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Line" Checked="OnToolChecked" ToolTip="Line (L) — hold Shift for 45° angles">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLine}" />
                    </RadioButton>
                    <RadioButton x:Name="RectangleTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Rectangle" Checked="OnToolChecked" ToolTip="Rectangle (R) — hold Shift for a square">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRect}" />
                    </RadioButton>
                    <RadioButton x:Name="EllipseTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Ellipse" Checked="OnToolChecked" ToolTip="Ellipse (E) — hold Shift for a circle">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEllipse}" />
                    </RadioButton>
                    <RadioButton x:Name="TextTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Text" Checked="OnToolChecked" ToolTip="Text (T) — Enter to finish, Shift+Enter for a new line">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconText}" />
                    </RadioButton>
                    <RadioButton x:Name="StepTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="StepMarker" Checked="OnToolChecked" ToolTip="Numbered step (N)">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="19" Height="19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" />
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="6,8" />
                    <RadioButton x:Name="RedactTool" GroupName="Tool" Style="{StaticResource ToolButton}" Tag="Redact" Checked="OnToolChecked" ToolTip="Redact (X) — permanently blacks out pixels">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRedact}" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Image viewport -->
            <ScrollViewer Grid.Column="1" x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource BackgroundBrush}" Focusable="False" Visibility="Collapsed"
                          PreviewMouseWheel="OnViewportMouseWheel" SizeChanged="OnViewportSizeChanged">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" BorderBrush="#2EFFFFFF" BorderThickness="1">
                    <!-- No bitmap effects here: they force an intermediate texture that large multi-monitor captures can exceed. -->
                    <Border x:Name="ZoomHost">
                        <Border.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        </Border.LayoutTransform>
                        <editor:AnnotationCanvas x:Name="Editor" />
                    </Border>
                </Border>
            </ScrollViewer>

            <!-- Start screen -->
            <Grid Grid.Column="1" x:Name="StartScreen">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Take a screenshot" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Capture, mark up and redact — then copy or save." FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,22" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource CaptureCard}" Click="OnCaptureRegion">
                            <StackPanel>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRegion}" Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6" /></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Region" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,2" />
                                <TextBlock Text="Ctrl+1" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CaptureCard}" Click="OnCaptureWindow">
                            <StackPanel>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWindow}" Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6" /></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Window" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,2" />
                                <TextBlock Text="Ctrl+2" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CaptureCard}" Click="OnCaptureDisplay">
                            <StackPanel>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconScreen}" Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6" /></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,2" />
                                <TextBlock Text="Ctrl+3" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CaptureCard}" Click="OnCaptureAll">
                            <StackPanel>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAllScreens}" Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6" /></Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Full screen" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,2" />
                                <TextBlock Text="Ctrl+4 · all displays" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="DisplaySummary" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ImageInfo" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Ready" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
