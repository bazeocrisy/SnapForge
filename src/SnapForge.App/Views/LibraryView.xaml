<UserControl x:Class="SnapForge.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SnapForge.App.Views"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="HeaderRowTemplate">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="6,16,0,8" Foreground="{DynamicResource TextBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="TileRowTemplate">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tile" Width="{Binding TileWidth}" Margin="6" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                                Background="{DynamicResource SurfaceBrush}" Padding="6" Cursor="Hand"
                                MouseLeftButtonDown="OnTileMouseDown" MouseMove="OnTileMouseMove" MouseLeftButtonUp="OnTileMouseUp"
                                ToolTip="{Binding Tooltip}" Tag="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <Border.ContextMenu>
                                <ContextMenu Opened="OnTileContextOpened">
                                    <MenuItem Header="_Open in Editor" Tag="open" Click="OnOpenSelected" FontWeight="SemiBold" InputGestureText="Enter" />
                                    <MenuItem Header="_Edit video (trim, frames, GIF)…" Tag="video-only" Click="OnEditVideo" />
                                    <MenuItem Header="_Rename…" Click="OnRename" InputGestureText="F2" />
                                    <MenuItem Header="_Duplicate" Tag="image-only" Click="OnDuplicate" />
                                    <MenuItem Header="Toggle _favorite" Click="OnToggleFavorite" />
                                    <MenuItem Header="_Tags…" Click="OnEditTags" />
                                    <MenuItem Header="Move to _folder…" Click="OnSetFolder" />
                                    <Separator />
                                    <MenuItem Header="_Export as PNG/JPEG…" Tag="export" Click="OnExport" />
                                    <MenuItem Header="Export editable capture (.sfcap)…" Tag="image-only" Click="OnExportPackage" />
                                    <MenuItem Header="_Sanitize…" Tag="image-only" Click="OnSanitize" />
                                    <Separator />
                                    <MenuItem x:Name="TrashItem" Header="Move to _Trash" Click="OnDelete" InputGestureText="Del" />
                                    <MenuItem Header="_Restore" Click="OnRestore" />
                                    <MenuItem Header="Delete _permanently…" Click="OnDeletePermanently" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Grid Height="{Binding ImageHeight}">
                                    <Border Background="{DynamicResource CanvasBackdropBrush}" CornerRadius="4" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <!-- Video: play badge and duration -->
                                    <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                                        <Ellipse Width="40" Height="40" Fill="#B0000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path Data="M0,0 L14,8 L0,16 Z" Fill="White" Width="14" Height="16" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Padding="5,1" Background="#C8000000">
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <Path Data="{StaticResource IconStar}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="None"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Padding="4,1"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding WarningText}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="2,6,2,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="2,1,2,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </DataTrigger>
                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <views:LibraryRowTemplateSelector x:Key="RowSelector" Header="{StaticResource HeaderRowTemplate}" Tiles="{StaticResource TileRowTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="10,12" x:Name="Sidebar">
                    <TextBlock Text="LIBRARY" Style="{StaticResource SectionHeader}" Margin="10,0,0,6" />
                    <RadioButton x:Name="AllView" GroupName="View" Style="{StaticResource SidebarItem}" Tag="All" IsChecked="True" Checked="OnViewChecked">
                        <DockPanel><TextBlock x:Name="AllCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" /><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconLibrary}" Width="22" /><TextBlock Text="All Captures" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="RecentView" GroupName="View" Style="{StaticResource SidebarItem}" Tag="Recent" Checked="OnViewChecked">
                        <DockPanel><TextBlock x:Name="RecentCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" /><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconClock}" Width="22" /><TextBlock Text="Recent (7 days)" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="FavoritesView" GroupName="View" Style="{StaticResource SidebarItem}" Tag="Favorites" Checked="OnViewChecked">
                        <DockPanel><TextBlock x:Name="FavoritesCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" /><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconStar}" Width="22" /><TextBlock Text="Favorites" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="VideosView" GroupName="View" Style="{StaticResource SidebarItem}" Tag="Videos" Checked="OnViewChecked">
                        <DockPanel><TextBlock x:Name="VideosCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" /><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconVideoMode}" Width="22" /><TextBlock Text="Videos" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="TrashView" GroupName="View" Style="{StaticResource SidebarItem}" Tag="Trash" Checked="OnViewChecked">
                        <DockPanel><TextBlock x:Name="TrashCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" /><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" Width="22" /><TextBlock Text="Trash" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></DockPanel>
                    </RadioButton>

                    <TextBlock Text="TAGS" Style="{StaticResource SectionHeader}" Margin="10,18,0,6" />
                    <StackPanel x:Name="TagsPanel" />
                    <TextBlock x:Name="NoTagsText" Text="No tags yet. Right-click a capture → Tags…" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0" />

                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionHeader}" Margin="10,18,0,6" />
                    <StackPanel x:Name="FoldersPanel" />
                    <TextBlock x:Name="NoFoldersText" Text="No folders yet. Right-click a capture → Move to folder…" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0" />

                    <TextBlock Text="STORAGE" Style="{StaticResource SectionHeader}" Margin="10,18,0,6" />
                    <TextBlock x:Name="StorageText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0" />
                    <TextBlock Text="Stored locally in:" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="10,2,10,0" />
                    <!-- Long paths are shortened in the middle-free way (trailing ellipsis); the full path is in the tooltip. -->
                    <TextBlock x:Name="StoragePathText" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="10,0" AutomationProperties.Name="Library location" />
                    <Button Style="{StaticResource LinkButton}" Content="Storage &amp; privacy settings…" HorizontalAlignment="Left" Margin="4,4,0,0" Click="OnStorageSettings" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize sidebar" />

        <!-- Main area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                <WrapPanel VerticalAlignment="Center">
                    <Grid Width="240" Margin="0,2,8,2" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="Search captures"
                                 ToolTip="Search titles, tags, folders, dates (yyyy-mm-dd) and sizes (e.g. 1920x1080)" />
                        <TextBlock x:Name="SearchHint" Text="Search captures…" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                    </Grid>
                    <Button x:Name="SortButton" Content="Sort: Newest ▾" Click="OnSortClick" Margin="0,2,8,2">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Newest first" Tag="NewestFirst" Click="OnSortChosen" />
                                <MenuItem Header="Oldest first" Tag="OldestFirst" Click="OnSortChosen" />
                                <MenuItem Header="Recently opened" Tag="RecentlyModified" Click="OnSortChosen" />
                                <MenuItem Header="Name (A–Z)" Tag="TitleAscending" Click="OnSortChosen" />
                                <MenuItem Header="Largest first" Tag="LargestFirst" Click="OnSortChosen" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                        <TextBlock Text="Size" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="SizeSlider" Width="110" Minimum="110" Maximum="320" Value="180" SmallChange="10" LargeChange="40" VerticalAlignment="Center"
                                ValueChanged="OnSizeChanged" AutomationProperties.Name="Thumbnail size" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                        <Button x:Name="ImportButton" Content="Import…" Click="OnImport" Margin="0,0,4,0" ToolTip="Import PNG, JPEG or BMP images (you can also drop files here)" />
                        <Button x:Name="OpenButton" Content="Open" Click="OnOpenSelected" Margin="0,0,4,0" IsEnabled="False" ToolTip="Open in Editor (Enter)" />
                        <Button x:Name="ExportButton" Content="Export…" Click="OnExport" Margin="0,0,4,0" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Move to Trash" Click="OnDelete" Margin="0,0,4,0" IsEnabled="False" ToolTip="Del" />
                        <Button x:Name="RestoreButton" Content="Restore" Click="OnRestore" Margin="0,0,4,0" Visibility="Collapsed" />
                        <Button x:Name="EmptyTrashButton" Content="Empty Trash…" Click="OnEmptyTrash" Margin="0,0,4,0" Visibility="Collapsed" />
                        <Button x:Name="MoreButton" Content="More ▾" Click="OnMore" Margin="0,0,10,0" IsEnabled="False">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="_Rename…" Click="OnRename" InputGestureText="F2" />
                                    <MenuItem Header="_Duplicate" Click="OnDuplicate" />
                                    <MenuItem Header="_Combine images side by side" Tag="Horizontal" Click="OnCombine" />
                                    <MenuItem Header="Combine images _stacked" Tag="Vertical" Click="OnCombine" />
                                    <MenuItem Header="Toggle _favorite" Click="OnToggleFavorite" />
                                    <MenuItem Header="_Tags…" Click="OnEditTags" />
                                    <MenuItem Header="Move to _folder…" Click="OnSetFolder" />
                                    <MenuItem Header="Export editable capture (.sfcap)…" Click="OnExportPackage" />
                                    <MenuItem Header="_Sanitize…" Click="OnSanitize" />
                                    <MenuItem Header="Delete _permanently…" Click="OnDeletePermanently" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock x:Name="SelectionText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <ItemsControl Grid.Row="1" x:Name="Rows" ItemTemplateSelector="{StaticResource RowSelector}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True" Focusable="True" KeyboardNavigation.IsTabStop="True"
                          SizeChanged="OnRowsSizeChanged" PreviewKeyDown="OnGridKeyDown" MouseLeftButtonDown="OnGridBackgroundClick"
                          AutomationProperties.Name="Captures" FocusVisualStyle="{x:Null}" Padding="12,0,12,12">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="RowsScroller" Focusable="False" CanContentScroll="True" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Grid.Row="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="No captures yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="Captures you take are saved here automatically." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
