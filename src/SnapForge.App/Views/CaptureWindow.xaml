<Window x:Class="SnapForge.App.Views.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapForge Capture"
        Width="760" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="../Assets/SnapForge.ico">
    <!--
        Compact horizontal capture control panel (milestone 3). Functional arrangement follows the owner's reference:
        menus; left mode rail; Selection / Effects / Share; option switches; large round Capture button with the
        hotkey beneath; Presets and Open Editor in the footer. SnapForge's own branding, icons and wording.
        Anything not implemented is disabled and says "Not available yet".
    -->
    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="PanelMenu" Padding="6,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Capture" InputGestureText="Enter" Click="OnCapture" FontWeight="SemiBold" />
                <MenuItem Header="Save current settings as _preset…" Click="OnSavePreset" />
                <Separator />
                <MenuItem Header="Se_ttings…" Click="OnSettings" />
                <Separator />
                <MenuItem Header="C_lose panel" InputGestureText="Esc" Click="OnClosePanel" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="ResetMenu" Header="_Reset capture options" Click="OnReset" />
                <MenuItem x:Name="UndoResetMenu" Header="_Undo reset" Click="OnUndoReset" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_View" SubmenuOpened="OnViewMenuOpened">
                <MenuItem Header="Open SnapForge _Editor" Click="OnOpenEditor" />
                <MenuItem Header="Open _Library" Click="OnOpenLibrary" />
                <Separator />
                <MenuItem x:Name="TopmostMenu" Header="Keep capture panel on _top" IsCheckable="True" Click="OnToggleTopmost" />
                <MenuItem x:Name="WidgetMenu" Header="Show capture _widget" Click="OnToggleWidget" ToolTip="Shows the capture widget at the top centre of the screen and opens it" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Click="OnShortcuts" />
                <MenuItem Header="Where are my captures? (_privacy)" Click="OnPrivacy" />
            </MenuItem>
        </Menu>

        <!-- Footer: presets, add preset, reset feedback, open editor/library -->
        <DockPanel DockPanel.Dock="Bottom" Margin="12,0,12,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="PresetsButton" Click="OnPresetsMenu" AutomationProperties.Name="Presets" ToolTip="Capture with a preset, or manage presets">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="Presets" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddPresetButton" Click="OnSavePreset" AutomationProperties.Name="Save current settings as a preset" ToolTip="Save current settings as a preset">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="18" Height="18" Stretch="Uniform" />
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Stretch="Uniform" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ResetNotice" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed">
                    <Run Text="Options reset." />
                    <Hyperlink Click="OnUndoReset" Foreground="{DynamicResource AccentBrush}">Undo</Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource LinkButton}" Click="OnOpenLibrary" AutomationProperties.Name="Open Library">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLibrary}" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="Open Library" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LinkButton}" Click="OnOpenEditor" AutomationProperties.Name="Open SnapForge Editor">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEditor}" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="Open SnapForge Editor" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Margin="10,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <!-- Mode rail -->
            <StackPanel x:Name="ModeRail" Grid.Column="0" VerticalAlignment="Top" AutomationProperties.Name="Capture mode">
                <RadioButton x:Name="AllInOneMode" GroupName="CaptureKind" Style="{StaticResource RailButton}" Content="All-in-One" Tag="{StaticResource IconAllInOne}"
                             IsEnabled="False" ToolTip="All-in-One — Not available yet" AutomationProperties.Name="All-in-One (Not available yet)" />
                <RadioButton x:Name="ImageMode" GroupName="CaptureKind" Style="{StaticResource RailButton}" Content="Image" Tag="{StaticResource IconImageMode}"
                             IsChecked="True" ToolTip="Image capture" AutomationProperties.Name="Image" />
                <RadioButton x:Name="VideoMode" GroupName="CaptureKind" Style="{StaticResource RailButton}" Content="Video" Tag="{StaticResource IconVideoMode}"
                             IsEnabled="False" ToolTip="Video recording — Not available yet" AutomationProperties.Name="Video (Not available yet)" />
            </StackPanel>

            <!-- Settings card -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="_Selection:" Target="{Binding ElementName=SelectionButton}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="0,0,10,0" />
                    <Button x:Name="SelectionButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource DropdownButton}" Margin="0,3" Click="OnSelectionMenu"
                            AutomationProperties.Name="Selection" ToolTip="What to capture">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="SelectionText" Text="Region" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <Label Grid.Row="1" Content="Effe_cts:" Target="{Binding ElementName=EffectsButton}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="0,0,10,0" />
                    <Button x:Name="EffectsButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource DropdownButton}" Margin="0,3" IsEnabled="False"
                            AutomationProperties.Name="Effects: None (Not available yet)" ToolTip="Effects — Not available yet">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="None" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <Label Grid.Row="2" Content="S_hare:" Target="{Binding ElementName=ShareButton}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="0,0,10,0" />
                    <Button x:Name="ShareButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource DropdownButton}" Margin="0,3" IsEnabled="False"
                            AutomationProperties.Name="Share: None (Not available yet)"
                            ToolTip="Share destinations — Not available yet. Use the Copy to Clipboard and Save to Library switches.">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="None" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <!-- Switches -->
                    <StackPanel Grid.Column="3" Grid.RowSpan="4" VerticalAlignment="Top">
                        <CheckBox x:Name="PreviewBox" Content="Preview in Editor" Click="OnOptionChanged" Margin="0,1" />
                        <CheckBox x:Name="CopyBox" Content="Copy to Clipboard" Click="OnOptionChanged" Margin="0,1" />
                        <CheckBox x:Name="SaveBox" Content="Save to Library" Click="OnOptionChanged" Margin="0,1"
                                  ToolTip="Off = capture without history: nothing is written to disk unless you export it." />
                        <CheckBox x:Name="CursorBox" Content="Cursor" Click="OnOptionChanged" Margin="0,1" ToolTip="Include the mouse pointer in the image" />
                        <DockPanel Margin="0,1">
                            <Button x:Name="DelayMenuButton" DockPanel.Dock="Right" Click="OnDelayMenu" Padding="4,2" Margin="2,0,0,0"
                                    AutomationProperties.Name="Choose delay" ToolTip="Choose the delay">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <CheckBox x:Name="DelayBox" Content="Time Delay" Click="OnDelayToggled" AutomationProperties.Name="Time Delay" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Capture -->
            <Grid Grid.Column="2">
                <Button x:Name="ResetButton" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4" Margin="0,-4,-6,0" Click="OnReset"
                        AutomationProperties.Name="Reset capture options" ToolTip="Reset capture options">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconReset}" Width="18" Height="18" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                    <Button x:Name="CaptureButton" Style="{StaticResource RoundCaptureButton}" Width="96" Height="96" Click="OnCapture"
                            IsDefault="True" AutomationProperties.Name="Capture">
                        <TextBlock Text="Capture" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Path x:Name="HotkeyWarningIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconWarning}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource WarningBrush}" Margin="0,0,4,0" Visibility="Collapsed" />
                        <TextBlock x:Name="HotkeyText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
