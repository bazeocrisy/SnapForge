<Window x:Class="SnapForge.App.Views.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapForge Capture"
        Width="380" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="../Assets/SnapForge.ico">
    <StackPanel Margin="18,14,18,16">
        <DockPanel>
            <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Button x:Name="CaptureButton" Style="{StaticResource AccentButton}" Margin="0,12,0,4" Padding="12,10" Click="OnCapture" AutomationProperties.Name="Capture">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCapture}" Stroke="{DynamicResource AccentForegroundBrush}" />
                <TextBlock Text="Capture" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="HotkeyText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

        <TextBlock Text="SELECTION" Style="{StaticResource SectionHeader}" />
        <UniformGrid Columns="4" x:Name="ModePanel">
            <RadioButton GroupName="Mode" Style="{StaticResource HToolButton}" Tag="Region" Checked="OnModeChecked" ToolTip="Drag to select an area" AutomationProperties.Name="Region">
                <StackPanel><Path Style="{StaticResource IconPath}" Data="{StaticResource IconRegion}" /><TextBlock Text="Region" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Mode" Style="{StaticResource HToolButton}" Tag="Window" Checked="OnModeChecked" ToolTip="Click a window" AutomationProperties.Name="Window">
                <StackPanel><Path Style="{StaticResource IconPath}" Data="{StaticResource IconWindow}" /><TextBlock Text="Window" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Mode" Style="{StaticResource HToolButton}" Tag="SingleScreen" Checked="OnModeChecked" ToolTip="Click a display" AutomationProperties.Name="Display">
                <StackPanel><Path Style="{StaticResource IconPath}" Data="{StaticResource IconScreen}" /><TextBlock Text="Display" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Mode" Style="{StaticResource HToolButton}" Tag="AllScreens" Checked="OnModeChecked" ToolTip="All displays" AutomationProperties.Name="Full screen">
                <StackPanel><Path Style="{StaticResource IconPath}" Data="{StaticResource IconAllScreens}" /><TextBlock Text="Full" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
        </UniformGrid>

        <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}" />
        <CheckBox x:Name="PreviewBox" Content="Preview in Editor" Click="OnOptionChanged" />
        <CheckBox x:Name="CopyBox" Content="Copy to clipboard" Click="OnOptionChanged" />
        <CheckBox x:Name="SaveBox" Content="Save to Library" Click="OnOptionChanged" />
        <TextBlock x:Name="SaveHint" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
        <CheckBox x:Name="CursorBox" Content="Capture mouse pointer" Click="OnOptionChanged" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Delay" VerticalAlignment="Center" Width="60" />
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="7" Padding="2" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" x:Name="DelayPanel">
                    <RadioButton GroupName="Delay" Style="{StaticResource SegmentButton}" Content="Off" Tag="0" Checked="OnDelayChecked" />
                    <RadioButton GroupName="Delay" Style="{StaticResource SegmentButton}" Content="1 s" Tag="1" Checked="OnDelayChecked" />
                    <RadioButton GroupName="Delay" Style="{StaticResource SegmentButton}" Content="3 s" Tag="3" Checked="OnDelayChecked" />
                    <RadioButton GroupName="Delay" Style="{StaticResource SegmentButton}" Content="5 s" Tag="5" Checked="OnDelayChecked" />
                    <RadioButton GroupName="Delay" Style="{StaticResource SegmentButton}" Content="10 s" Tag="10" Checked="OnDelayChecked" />
                </StackPanel>
            </Border>
        </DockPanel>

        <DockPanel Margin="0,14,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Save current as preset" Click="OnSavePreset" />
            <TextBlock Text="PRESETS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl x:Name="PresetList" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="10,6" Margin="0,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Capture with this preset" Click="OnRunPreset" FontWeight="SemiBold" />
                                <MenuItem Header="_Use these settings" Click="OnApplyPreset" />
                                <MenuItem Header="Set _hotkey…" Click="OnPresetHotkey" />
                                <MenuItem Header="_Rename…" Click="OnRenamePreset" />
                                <MenuItem Header="_Delete" Click="OnDeletePreset" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Capture" Click="OnRunPreset" MinHeight="26" Padding="10,2" AutomationProperties.Name="{Binding Name}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Right-click a preset to set a hotkey, rename or delete it." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

        <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Center">
            <Button Style="{StaticResource LinkButton}" Content="Open Editor" Click="OnOpenEditor" />
            <Button Style="{StaticResource LinkButton}" Content="Open Library" Click="OnOpenLibrary" />
            <Button Style="{StaticResource LinkButton}" Content="Settings" Click="OnSettings" />
        </WrapPanel>
    </StackPanel>
</Window>
