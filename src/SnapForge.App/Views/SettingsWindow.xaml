<Window x:Class="SnapForge.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapForge Settings"
        Width="640" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" Click="OnClose" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,8,22,20">
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Windows setting" Tag="System" Checked="OnThemeChecked" />
                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Light" Tag="Light" Checked="OnThemeChecked" />
                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Dark" Tag="Dark" Checked="OnThemeChecked" />
                </StackPanel>

                <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="CloseToTrayBox" Content="Keep running in the notification area when the window is closed (hotkeys keep working)" Click="OnBehaviourChanged" />
                <CheckBox x:Name="ShowCaptureWindowBox" Content="Show the Capture window when SnapForge starts" Click="OnBehaviourChanged" />

                <CheckBox x:Name="StartupBox" Content="Launch SnapForge when I sign in to Windows (starts in the notification area)" Click="OnStartupChanged"
                          AutomationProperties.Name="Launch with Windows" />
                <TextBlock x:Name="StartupStatus" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="26,0,0,4" />

                <TextBlock Text="CAPTURE WIDGET" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="WidgetEnabledBox" Content="Show the capture widget at the screen edge" Click="OnWidgetChanged" AutomationProperties.Name="Show the capture widget" />
                <CheckBox x:Name="WidgetTopmostBox" Content="Keep the widget on top of other windows" Click="OnWidgetChanged" />
                <CheckBox x:Name="WidgetAutoHideBox" Content="Auto-hide: shrink to a thin strip until the pointer touches it" Click="OnWidgetChanged" />
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Open the widget" VerticalAlignment="Center" Width="130" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WidgetHover" GroupName="WidgetMode" Style="{StaticResource SegmentButton}" Content="On hover" Checked="OnWidgetChanged" />
                        <RadioButton x:Name="WidgetClick" GroupName="WidgetMode" Style="{StaticResource SegmentButton}" Content="On click" Checked="OnWidgetChanged" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Move widget to top centre" Click="OnWidgetReset" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="Drag the widget by its grip to dock it at the top, left or right edge of any display; it remembers the place. It never takes keyboard focus and is hidden while a capture is taken." />

                <TextBlock Text="DRAG AND DROP" Style="{StaticResource SectionHeader}" />
                <DockPanel>
                    <TextBlock Text="Dragged captures become" VerticalAlignment="Center" Width="170" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DragPng" GroupName="DragFormat" Style="{StaticResource SegmentButton}" Content="PNG (lossless)" Checked="OnDragFormatChanged" />
                        <RadioButton x:Name="DragJpeg" GroupName="DragFormat" Style="{StaticResource SegmentButton}" Content="JPEG (smaller)" Checked="OnDragFormatChanged" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBox x:Name="JpegQualityBox" DockPanel.Dock="Right" Width="70" LostFocus="OnDragFormatChanged" AutomationProperties.Name="JPEG quality" />
                    <TextBlock Text="JPEG quality (1–100)" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                           Text="Dragging a capture to Explorer, the desktop, Office, mail, chat or a browser copies a flattened image (annotations applied, redactions burned in, no metadata) named after the capture and its time. Editable captures and original pixels are never included. Temporary copies are deleted automatically." />

                <TextBlock Text="HOTKEYS" Style="{StaticResource SectionHeader}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearHotkey" Margin="8,0,0,0" />
                    <TextBlock Text="Capture (current settings)" VerticalAlignment="Center" Width="190" />
                    <TextBox x:Name="CaptureHotkeyBox" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" AutomationProperties.Name="Capture hotkey"
                             ToolTip="Click here and press the key combination (e.g. Print Screen or Ctrl+Shift+S)" />
                </DockPanel>
                <TextBlock x:Name="HotkeyStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"
                           Text="If Print Screen is reported as in use, Windows is probably using it to open the Snipping Tool: Settings → Accessibility → Keyboard → turn off “Use the Print screen key to open screen capture”, then reopen this window. Preset hotkeys are set from the Capture window (right-click a preset)." />

                <TextBlock Text="CAPTURE LIBRARY" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Location (local disk; SnapForge never uploads captures):" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="LocationBox" IsReadOnly="True" Margin="0,4,0,6" AutomationProperties.Name="Library location" />
                <WrapPanel>
                    <Button Content="Open folder" Click="OnOpenFolder" Margin="0,0,6,6" />
                    <Button Content="Change location…" Click="OnChangeLocation" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock x:Name="UsageText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="Retention" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,4" />
                <DockPanel>
                    <TextBox x:Name="TrashDaysBox" DockPanel.Dock="Right" Width="70" LostFocus="OnRetentionChanged" AutomationProperties.Name="Days to keep items in Trash" />
                    <CheckBox x:Name="TrashDaysCheck" Content="Permanently delete captures that have been in the Trash for more than (days)" Click="OnRetentionChanged" />
                </DockPanel>
                <DockPanel>
                    <TextBox x:Name="KeepDaysBox" DockPanel.Dock="Right" Width="70" LostFocus="OnRetentionChanged" AutomationProperties.Name="Days to keep captures" />
                    <CheckBox x:Name="KeepDaysCheck" Content="Move captures older than (days) to the Trash (favorites are kept)" Click="OnRetentionChanged" />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Apply retention now" Click="OnApplyRetention" Margin="0,0,6,6" />
                    <Button Content="Empty Trash…" Click="OnEmptyTrash" Margin="0,0,6,6" />
                </WrapPanel>

                <TextBlock Text="Backup" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,4" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="A backup is a ZIP of all editable captures (including any original pixels kept under unsanitized redactions). Store it somewhere safe; restoring never overwrites existing captures." />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Back up library…" Click="OnBackup" Margin="0,0,6,6" />
                    <Button Content="Restore from backup…" Click="OnRestore" Margin="0,0,6,6" />
                </WrapPanel>

                <TextBlock Text="PRIVACY" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="PrivacyText" FontSize="12" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Sanitize all captures with redactions…" Click="OnSanitizeAll" Margin="0,0,6,6" />
                    <Button Content="Show privacy &amp; storage notice" Click="OnPrivacyNotice" Margin="0,0,6,6" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
