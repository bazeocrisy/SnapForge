<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SnapForge.App</RootNamespace>
    <AssemblyName>SnapForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnapForge.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>SnapForge screenshot capture and annotation tool</Description>
    <!-- Portable build: dotnet publish with win-x64, self-contained, single file.
         Native WPF libraries stay next to the exe (no IncludeNativeLibrariesForSelfExtract), so nothing is
         extracted into %TEMP%\.net at run time. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SnapForge.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapForge.Core\SnapForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnapForge.App.Tests" />
  </ItemGroup>

</Project>
