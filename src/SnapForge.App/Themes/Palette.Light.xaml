<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme palette. Swapped at run time by ThemeManager; all styles use DynamicResource. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F7F7F9" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E9E9EE" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCDCE3" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D3D3DA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5A5E66" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9530F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E8611A" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#22D9530F" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CanvasBackdropBrush" Color="#E2E2E7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A4B00" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#22E08A00" />
</ResourceDictionary>
