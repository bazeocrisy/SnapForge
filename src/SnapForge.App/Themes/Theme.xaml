<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="BackgroundColor">#17181B</Color>
    <Color x:Key="SurfaceColor">#1F2024</Color>
    <Color x:Key="SurfaceRaisedColor">#26282D</Color>
    <Color x:Key="HoverColor">#30333A</Color>
    <Color x:Key="PressedColor">#3A3D45</Color>
    <Color x:Key="BorderColor">#34373E</Color>
    <Color x:Key="TextColor">#EDEEF0</Color>
    <Color x:Key="MutedTextColor">#9DA1A8</Color>
    <Color x:Key="AccentColor">#FF7A30</Color>
    <Color x:Key="AccentHoverColor">#FF9150</Color>
    <Color x:Key="AccentSubtleColor">#33FF7A30</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Icon path style: 24x24 stroke icons -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" RadiusX="7" RadiusY="7" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat toolbar button -->
    <Style x:Key="ToolbarButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#1A1205" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical tool palette entry -->
    <Style x:Key="ToolButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" />
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-6,0,0,0"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Color swatch -->
    <Style x:Key="SwatchButton" TargetType="RadioButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                        <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource MutedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented size choice -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large capture card on the start screen -->
    <Style x:Key="CaptureCard" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Width" Value="168" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Separator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- Slim dark scrollbars for the image viewport -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#55FFFFFF" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon geometries (24x24) -->
    <Geometry x:Key="IconRegion">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15 M9,12 H15 M12,9 V15</Geometry>
    <Geometry x:Key="IconWindow">M3.5,5 H20.5 V19 H3.5 Z M3.5,9 H20.5 M6.5,7 H7 M9,7 H9.5</Geometry>
    <Geometry x:Key="IconScreen">M3,4.5 H21 V16 H3 Z M8.5,20 H15.5 M12,16 V20</Geometry>
    <Geometry x:Key="IconAllScreens">M2,6 H12 V14 H2 Z M12,9 H22 V17 H12 M5,18 H9 M7,14 V18 M15,20.5 H19 M17,17 V20.5</Geometry>
    <Geometry x:Key="IconSelect">M6,3 L6,18.5 L10,14.8 L12.8,21 L15.3,19.9 L12.6,13.8 L18,13.8 Z</Geometry>
    <Geometry x:Key="IconArrow">M5,19 L18,6 M10,5.5 H18.5 V14</Geometry>
    <Geometry x:Key="IconLine">M5,19 L19,5</Geometry>
    <Geometry x:Key="IconRect">M4,6 H20 V18 H4 Z</Geometry>
    <Geometry x:Key="IconEllipse">M12,5 C17,5 20.5,8 20.5,12 C20.5,16 17,19 12,19 C7,19 3.5,16 3.5,12 C3.5,8 7,5 12,5 Z</Geometry>
    <Geometry x:Key="IconText">M5,6.5 V5 H19 V6.5 M12,5 V19 M9,19 H15</Geometry>
    <Geometry x:Key="IconRedact">M3.5,8 H20.5 V16 H3.5 Z M6.5,11 H17.5 M6.5,13 H14</Geometry>
    <Geometry x:Key="IconUndo">M9,13.5 L4.5,9 L9,4.5 M4.5,9 H14.5 C17.5,9 19.5,11.2 19.5,14 C19.5,16.8 17.5,19 14.5,19 H11</Geometry>
    <Geometry x:Key="IconRedo">M15,13.5 L19.5,9 L15,4.5 M19.5,9 H9.5 C6.5,9 4.5,11.2 4.5,14 C4.5,16.8 6.5,19 9.5,19 H13</Geometry>
    <Geometry x:Key="IconCopy">M8,8 H19 V20 H8 Z M5,16 V4 H15</Geometry>
    <Geometry x:Key="IconSave">M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M5,19.5 H19</Geometry>
    <Geometry x:Key="IconDelete">M5,7 H19 M9.5,7 V4.5 H14.5 V7 M7,7 L8,20 H16 L17,7 M10.5,10.5 V16.5 M13.5,10.5 V16.5</Geometry>
    <Geometry x:Key="IconFit">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</Geometry>
    <Geometry x:Key="IconZoomIn">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.2,15.2 L20,20 M8,10.5 H13 M10.5,8 V13</Geometry>
    <Geometry x:Key="IconZoomOut">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.2,15.2 L20,20 M8,10.5 H13</Geometry>
</ResourceDictionary>
