<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme palette. Swapped at run time by ThemeManager; all styles use DynamicResource. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#17181B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2024" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#26282D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#30333A" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3A3D45" />
    <SolidColorBrush x:Key="BorderBrush" Color="#34373E" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDEEF0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA1A8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A30" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9150" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#33FF7A30" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1A1205" />
    <SolidColorBrush x:Key="CanvasBackdropBrush" Color="#121315" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33FFB74D" />
</ResourceDictionary>
