<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Lets the Windows-only projects compile on Linux/macOS (CI and dev containers). They still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>SnapForge contributors</Company>
    <Product>SnapForge</Product>
    <Version>0.1.0-dev</Version>
    <Copyright>Copyright © 2026 SnapForge contributors</Copyright>
  </PropertyGroup>
</Project>
